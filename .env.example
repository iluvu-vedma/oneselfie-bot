# Telegram
BOT_TOKEN=
# Секрет вебхука: Telegram шлёт его в X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=
# chat_id владельца — видит /stats, /admin и лог провалов в личке
OWNER_CHAT_ID=
# Кто ещё пускается в /admin: chat_id через запятую. Пусто — только владелец.
# Админка показывает чужие балансы и двигает их — список закрытый и живёт тут,
# а не раздаётся кнопкой внутри бота.
ADMIN_IDS=

# kie.ai
KIE_API_KEY=
# KIE_BASE_URL=https://api.kie.ai
# Загрузка файлов у kie.ai — отдельный хост, не api.kie.ai
# KIE_UPLOAD_BASE_URL=https://kieai.redpandaai.co

# Публичный адрес деплоя, без слеша на конце
PUBLIC_URL=https://your-app.vercel.app
# Секрет для /api/kie-callback и /api/sweep. Без него эндпоинты открыты всем.
CALLBACK_SECRET=

# KV: Upstash напрямую…
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# …или Vercel KV (интеграция подставляет их сама)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Картинка-пример при первом /start: сетка реальных результатов.
# Пусто — вход уходит текстом без картинки.
EXAMPLE_IMAGE_URL=

# Внешние ссылки. Пусто — кнопка не рисуется вовсе:
# кнопка, ведущая в никуда, хуже отсутствующей. Только https.
# Новости продукта — кнопка на главном экране.
CHANNEL_URL=
# Канал с промптами — кнопка там, где человек завис над пустым полем ввода.
PROMPTS_CHANNEL_URL=
# Куда писать, если сломалось. Без адреса строки в справке просто нет.
SUPPORT_URL=
